# trendarsa-app / trendev-web ile paylaşılan Supabase projesi.
# Bu panel tamamen client-side çalıştığı için NEXT_PUBLIC_ önekiyle okunur —
# anon key zaten public'tir, gerçek güvenlik Supabase RLS'den gelir.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://cdn.example.com
